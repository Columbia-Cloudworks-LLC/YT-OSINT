<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="YT-OSINT | YouTube Corpus" Width="1280" Height="820" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="34"/></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="34"/></Style>
<Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="34"/><Setter Property="MinWidth" Value="200"/></Style>
<Style TargetType="DataGrid"><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="AlternatingRowBackground" Value="#F0F4FA"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="SelectionMode" Value="Single"/></Style>
<Style TargetType="TabItem"><Setter Property="Padding" Value="15,9"/></Style>
</Window.Resources>
<DockPanel Margin="16">
<Border DockPanel.Dock="Top" Background="#172B45" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="YT-OSINT" FontSize="25" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="YouTube transcript corpus · Capture, search, and open the source" Foreground="#CBD8E9" Margin="0,6,0,0"/></StackPanel></Border>
<StatusBar DockPanel.Dock="Bottom" Margin="0,12,0,0" Background="#E4EAF2"><StatusBarItem><TextBlock x:Name="Status" Text="Starting…" Width="620" TextTrimming="CharacterEllipsis"/></StatusBarItem><StatusBarItem><ProgressBar x:Name="Progress" Width="210" Height="16"/></StatusBarItem><StatusBarItem><Button x:Name="Cancel" Content="Cancel" IsEnabled="False"/></StatusBarItem></StatusBar>
<TabControl x:Name="Tabs">
<TabItem Header="Subjects"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Subjects explicitly group channels. Removing an association preserves captured evidence." Margin="4,4,4,12"/><WrapPanel><ComboBox x:Name="SubjectPick" DisplayMemberPath="name"/><TextBox x:Name="SubjectName" Width="260" ToolTip="Subject display name"/><Button x:Name="CreateSubject" Content="Create subject"/><Button x:Name="RenameSubject" Content="Rename selected"/></WrapPanel><WrapPanel><TextBox x:Name="ChannelUrl" Width="490" ToolTip="HTTPS YouTube channel URL"/><Button x:Name="AddChannel" Content="Add channel"/><Button x:Name="RemoveChannel" Content="Remove selected association"/></WrapPanel></StackPanel><DataGrid x:Name="SubjectChannels" Margin="4,12,4,4"/></DockPanel></TabItem>
<TabItem Header="Channels"><DockPanel Margin="12"><WrapPanel DockPanel.Dock="Top"><Button x:Name="SyncSelected" Content="Sync selected channel"/><Button x:Name="SyncAll" Content="Sync all channels"/><Button x:Name="Refresh" Content="Refresh"/><TextBlock Text="Each sync also rebuilds the workbook." VerticalAlignment="Center" Margin="12,0"/></WrapPanel><DataGrid x:Name="ChannelsGrid" Margin="4,12,4,4"/></DockPanel></TabItem>
<TabItem Header="Individual Videos"><StackPanel Margin="20"><TextBlock Text="Import an individual video" FontSize="22" Margin="4,0,4,16"/><TextBlock Text="Video URL" Margin="4"/><TextBox x:Name="VideoUrl"/><TextBlock Text="Associate with a subject (optional)" Margin="4,16,4,4"/><ComboBox x:Name="VideoSubject" DisplayMemberPath="name" HorizontalAlignment="Left"/><WrapPanel><Button x:Name="ClearVideoSubject" Content="Use no subject"/><TextBox x:Name="NewVideoSubject" Width="260" ToolTip="Create a new subject for this video"/><Button x:Name="CreateVideoSubject" Content="Create and select subject"/></WrapPanel><Button x:Name="ImportVideo" Content="Import video and build workbook" HorizontalAlignment="Left" Margin="4,20,4,4"/><TextBlock Text="Metadata and English subtitles only. Full video media is never downloaded." Margin="4,12"/></StackPanel></TabItem>
<TabItem Header="Corpus"><DockPanel Margin="12"><WrapPanel DockPanel.Dock="Top"><TextBox x:Name="CorpusFilter" Width="330" ToolTip="Filter by subject, channel, title, ID or status"/><Button x:Name="FilterCorpus" Content="Filter"/><Button x:Name="Build" Content="Build Excel workbook"/><Button x:Name="OpenWorkbook" Content="Open workbook"/></WrapPanel><DataGrid x:Name="CorpusGrid" Margin="4,12,4,4"/></DockPanel></TabItem>
<TabItem Header="Search"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><WrapPanel><TextBox x:Name="Query" Width="470" ToolTip="Transcript text (literal, case insensitive)"/><Button x:Name="Search" Content="Search transcripts"/><Button x:Name="OpenResult" Content="Open at timestamp"/></WrapPanel><WrapPanel><ComboBox x:Name="SearchSubject" DisplayMemberPath="name"/><Button x:Name="ClearSearchSubject" Content="All subjects"/><TextBox x:Name="SearchChannel" Width="180" ToolTip="Channel name or ID"/><TextBox x:Name="SearchVideo" Width="180" ToolTip="Video title or ID"/></WrapPanel><WrapPanel><TextBlock Text="Published from" VerticalAlignment="Center" Margin="4"/><DatePicker x:Name="DateFrom" Width="160" Margin="4"/><TextBlock Text="through" VerticalAlignment="Center" Margin="4"/><DatePicker x:Name="DateTo" Width="160" Margin="4"/></WrapPanel></StackPanel><TextBox x:Name="ContextText" DockPanel.Dock="Bottom" Height="105" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="Preceding, matching and following transcript context"/><DataGrid x:Name="SearchGrid" Margin="4,12,4,4"/></DockPanel></TabItem>
<TabItem Header="Logs / Status"><DockPanel Margin="12"><Button x:Name="OpenLogs" DockPanel.Dock="Top" Content="Open logs folder" HorizontalAlignment="Left"/><TextBox x:Name="LogText" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel></TabItem>
<TabItem Header="Settings"><StackPanel Margin="24"><TextBlock Text="Local corpus settings" FontSize="22"/><TextBlock x:Name="Paths" Margin="0,20" TextWrapping="Wrap"/><TextBlock Text="English manual captions are preferred; English automatic captions are used when manual captions are unavailable.&#10;&#10;Dependencies are checked on startup. Existing Windows binaries are preserved.&#10;&#10;Edit source associations in Subjects. Config changes take effect on the next operation.&#10;&#10;One writer runs at a time. Search, imports and Excel builds execute in a background runspace." TextWrapping="Wrap"/><WrapPanel Margin="0,20"><Button x:Name="OpenData" Content="Open data folder"/><Button x:Name="OpenConfig" Content="Open configuration"/></WrapPanel></StackPanel></TabItem>
</TabControl></DockPanel></Window>
