<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:q="clr-namespace:YouTubeCorpus;assembly=QueueViewAssembly" Title="YT-OSINT | YouTube Corpus" Width="1280" Height="820" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="34"/></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="34"/></Style>
<Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="34"/><Setter Property="MinWidth" Value="200"/></Style>
<Style TargetType="DataGrid"><Setter Property="CanUserSortColumns" Value="True"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="AlternatingRowBackground" Value="#F0F4FA"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="SelectionMode" Value="Single"/></Style>
<Style TargetType="TabItem"><Setter Property="Padding" Value="15,9"/></Style>
<Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
<Setter Property="Background" Value="#145DA0"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#145DA0" BorderThickness="2" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#094184"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFD166"/><Setter TargetName="Surface" Property="BorderThickness" Value="3"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
</Window.Resources>
<DockPanel Margin="16">
<Border x:Name="BrandHeader" DockPanel.Dock="Top" Height="104" Background="#B51E34" Margin="0,0,0,14" ClipToBounds="True"><Grid>
<Image x:Name="HeaderArtwork" Stretch="UniformToFill"/>
<Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#B0201018" Offset="0"/><GradientStop Color="#40201018" Offset="0.6"/><GradientStop Color="#00201018" Offset="1"/></LinearGradientBrush></Border.Background></Border>
<StackPanel x:Name="HeaderText" Margin="20"><StackPanel.Effect><DropShadowEffect Color="#180810" BlurRadius="4" ShadowDepth="1" Opacity="1"/></StackPanel.Effect><TextBlock Text="YT-OSINT" FontSize="25" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="HeaderTagline" Text="YouTube transcript corpus &#xB7; Capture, search, and open the source" Foreground="White" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
</Grid></Border>
<Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Background="#E4EAF2" Padding="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock x:Name="GlobalQueueStatus" Text="Queue: Loading" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/><DockPanel><TextBlock Text="Other tasks: " FontWeight="SemiBold"/><TextBlock x:Name="Status" Text="Starting" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel><ProgressBar x:Name="Progress" Height="5" Margin="0,4,12,0"/></StackPanel>
<Button x:Name="Cancel" Grid.Column="1" Content="Cancel task" IsEnabled="False" ToolTip="Cancel the foreground task. Use Pause in Video Queue to pause downloads."/>
</Grid></Border>
<TabControl x:Name="Tabs">
<TabItem Header="Subjects"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="230" MinWidth="170"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DockPanel Margin="4"><Button x:Name="CreateSubject" DockPanel.Dock="Top" Content="Add subject" HorizontalAlignment="Left"/><ComboBox AutomationProperties.Name="Subject sort order" x:Name="SubjectSort" DockPanel.Dock="Top" SelectedIndex="0" MinWidth="0"><ComboBoxItem Content="A–Z"/><ComboBoxItem Content="Z–A"/></ComboBox><TextBlock DockPanel.Dock="Top" Text="Select a subject to manage its channels." Margin="4,8" TextWrapping="Wrap"/><ListBox AutomationProperties.Name="Subjects" x:Name="SubjectPick" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel ToolTip="{Binding StatusLabel}"><TextBlock Text="{Binding name}"/><TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="#52657A" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
<GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#D7DFEB"/>
<ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="12,4,4,4" MinHeight="580"><Grid.RowDefinitions><RowDefinition Height="3*" MinHeight="330"/><RowDefinition Height="8"/><RowDefinition Height="2*" MinHeight="240"/></Grid.RowDefinitions><DockPanel><StackPanel DockPanel.Dock="Top">
<TextBlock x:Name="SubjectHeading" Text="Select or add a subject" FontSize="22" Margin="4,8"/>
<Label Content="Subject name" Target="{Binding ElementName=SubjectName}"/><WrapPanel><TextBox x:Name="SubjectName" AutomationProperties.Name="Subject name" Width="260" ToolTip="Selected subject name"/><Button x:Name="RenameSubject" Content="Rename subject"/><Button x:Name="RemoveSubject" Content="Remove subject"/></WrapPanel>
<TextBlock x:Name="SubjectLockNotice" Margin="8" Foreground="#815A16" TextWrapping="Wrap"/>
<Label Content="Channel URL (for example, https://www.youtube.com/@channel)" Target="{Binding ElementName=ChannelUrl}"/><WrapPanel><TextBox x:Name="ChannelUrl" AutomationProperties.Name="Channel URL" Width="360" ToolTip="HTTPS YouTube channel URL"/><Button x:Name="AddChannel" Content="Add channel"/><Button x:Name="RemoveChannel" Content="Remove selected channel"/></WrapPanel>
<TextBlock Text="Removing a subject preserves its captured videos and transcripts." Margin="8" TextWrapping="Wrap"/>
</StackPanel><DataGrid x:Name="SubjectChannels" AutoGenerateColumns="False" Margin="4,12,4,4"><DataGrid.Columns><DataGridTextColumn Header="Channel" Binding="{Binding Url}" Width="*"/><DataGridTextColumn Header="Sync status" Binding="{Binding StatusLabel}" Width="240"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="4"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Last full sync (UTC)" Binding="{Binding LastSuccessfulSync}" Width="160"/></DataGrid.Columns></DataGrid></DockPanel><GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#D7DFEB"/><StackPanel Grid.Row="2"><TextBlock Text="Batch video imports" FontSize="22" Margin="4,0,4,8"/>
<TextBlock Text="Paste one video URL per line. Downloads belong to the selected subject." Margin="4"/>
<TextBox AutomationProperties.Name="Video URLs, one per line" x:Name="VideoUrl" Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" ToolTip="One HTTPS YouTube video URL per line"/>

<WrapPanel><CheckBox x:Name="RefreshVideoTranscript" Content="Refresh saved transcripts" Margin="8" VerticalAlignment="Center"/><Button x:Name="ImportVideo" Content="Add URLs to queue"/></WrapPanel><WrapPanel><TextBlock x:Name="QueueAddNotice" Margin="8" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="OpenQueueFromSubjects" Content="Open queue" Visibility="Collapsed"/></WrapPanel>
</StackPanel></Grid></ScrollViewer>
</Grid></TabItem>
<TabItem Header="Channels"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="230" MinWidth="170"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DockPanel Margin="4"><WrapPanel DockPanel.Dock="Top"><Button x:Name="SyncAll" Content="Queue all channels"/><Button x:Name="Refresh" Content="Refresh"/></WrapPanel><ListBox AutomationProperties.Name="Channels" x:Name="ChannelsGrid" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel ToolTip="{Binding StatusHint}"><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="#52657A" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
<GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#D7DFEB"/>
<DockPanel Grid.Column="2" Margin="12,4"><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="ChannelHeading" Text="Select a channel" FontSize="22" Margin="4,8" TextWrapping="Wrap"/><TextBlock x:Name="ChannelSyncStatus" Margin="4,8" TextWrapping="Wrap"/><TextBlock x:Name="ChannelLastResult" Margin="4" TextWrapping="Wrap"/><TextBlock x:Name="ChannelFreshness" Margin="4,4,4,12" TextWrapping="Wrap"/><WrapPanel><Button x:Name="SyncSelected" Content="Queue channel sync"/><Button x:Name="CancelSync" Content="Cancel sync"/><CheckBox x:Name="RefreshChannelTranscripts" Content="Refresh saved transcripts" Margin="8" VerticalAlignment="Center"/></WrapPanel><WrapPanel><TextBlock x:Name="ChannelQueueNotice" Margin="4" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="OpenQueueFromChannels" Content="Open queue" Visibility="Collapsed"/></WrapPanel></StackPanel>
<DataGrid x:Name="ChannelDetails" AutoGenerateColumns="False" Margin="4,12"><DataGrid.Columns><DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="190"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel>
</Grid></TabItem>
<TabItem x:Name="QueueTab" Header="Video Queue"><DockPanel Margin="16">
<ScrollViewer x:Name="QueueControlsScroll" DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<TextBlock Text="Download queue" FontSize="22" FontWeight="SemiBold" Margin="4,0,4,8"/>
<ProgressBar x:Name="QueueProgress" Height="8" Margin="4,6,4,8" Foreground="#176BC1"/>
<TextBlock x:Name="QueueActivity" Text="Start lists every queued channel before downloading videos." Margin="4,0,4,8" TextWrapping="Wrap" Foreground="#52657A"/>
<CheckBox x:Name="QueueReview" Content="Pause after channel discovery for review" IsChecked="True" Margin="8,4" ToolTip="List queued channels, then pause before capture. Choose Capture queued videos after reviewing."/>
<WrapPanel x:Name="QueueSelectedActions" Visibility="Collapsed"><Button x:Name="QueueRemove" Content="Remove selected pending items"/><Button x:Name="QueueRetry" Content="Retry selected"/><Button x:Name="QueueUp" Content="Move up" ToolTip="Move one selected pending video earlier in download order."/><Button x:Name="QueueDown" Content="Move down" ToolTip="Move one selected pending video later in download order."/><TextBlock x:Name="QueueSelection" Margin="8,4" VerticalAlignment="Center"/></WrapPanel>
<Expander x:Name="QueueCleanup" Header="Queue cleanup" IsExpanded="False" Margin="4"><WrapPanel><Button x:Name="QueueClear" Content="Clear successful history" ToolTip="Remove completed and skipped rows. Failed and cancelled items remain available to retry; captures are kept."/><Button x:Name="QueueClearHistory" Content="Clear all history" ToolTip="Remove all finished rows, including failures and cancellations. Pending/running work and captures are kept."/><Button x:Name="QueueClearAll" Content="Clear queue" ToolTip="Remove all queue rows except the current download, cancel channel discovery, and pause the queue. The current download may finish; captured files are preserved."/></WrapPanel></Expander>

<Expander x:Name="QueueFilters" Header="Filters and selection" IsExpanded="False" Margin="4"><StackPanel><WrapPanel><TextBlock Text="Est. publish date before" VerticalAlignment="Center" Margin="8,4"/><DatePicker AutomationProperties.Name="Estimated publish date before" x:Name="QueueBefore" Width="145" Margin="4"/><Button x:Name="QueueSelectBefore" Content="Select pending before date" ToolTip="Replace the selection with pending videos strictly before this date across all channels. Unknown dates stay unselected."/></WrapPanel>
<TextBlock Text="Dates may be approximate. Unknown dates stay unselected; capture updates dates when available." Foreground="#52657A" Margin="8,4" TextWrapping="Wrap"/>
</StackPanel></Expander>
</StackPanel></ScrollViewer>
<StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="QueueStatus" Text="Queue paused" Margin="4" TextWrapping="Wrap"/>
<Grid DockPanel.Dock="Bottom" Margin="4,10,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock x:Name="QueueHint" Text="Lower queue order downloads first. Shift-click selects a range. Clear queue keeps the current download." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/>
<Button x:Name="QueueToggle" Style="{StaticResource PrimaryAction}" Grid.Column="1" Content="Capture queued videos" MinWidth="160" ToolTip="Start the entire queue. Queued channels are listed before video downloads."/>
</Grid></StackPanel>
<q:QueueGrid AutomationProperties.Name="Video queue" x:Name="QueueGrid" Style="{StaticResource {x:Type DataGrid}}" SelectionMode="Extended" SelectionUnit="FullRow" AutoGenerateColumns="False" Margin="4" RowHeight="36" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><DataGrid.Columns>
<DataGridTextColumn Header="Queue order" Binding="{Binding QueueOrder}" SortMemberPath="QueueOrder" Width="100"/>
<DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4" ToolTip="{Binding Detail}"><Border Width="20" Height="20" CornerRadius="10" Background="{Binding StatusColor}" Margin="0,0,7,0"><TextBlock Text="{Binding StatusGlyph}" Foreground="White" FontFamily="Segoe UI Symbol" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding StatusLabel}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTextColumn Header="Video" Binding="{Binding Title}" Width="240"/>
<DataGridTextColumn Header="Est. Publish Date" Binding="{Binding PublishedDateLabel}" SortMemberPath="EstPublishedDate" Width="140"/>
<DataGridTextColumn Header="Subject" Binding="{Binding SubjectName}" Width="150"/>
<DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="200"/>
<DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*" MinWidth="120"/>
</DataGrid.Columns></q:QueueGrid>
</DockPanel></TabItem>
<TabItem x:Name="CorpusTab" Header="Corpus"><DockPanel Margin="12">
<ScrollViewer x:Name="CorpusControlsScroll" DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<WrapPanel VerticalAlignment="Bottom"><StackPanel><Label Content="Search _in" Target="{Binding ElementName=SearchMode}"/><ComboBox x:Name="SearchMode" AutomationProperties.Name="Search in" SelectedIndex="0" MinWidth="180"><ComboBoxItem Content="Video details"/><ComboBoxItem Content="Transcripts"/></ComboBox></StackPanel><StackPanel><Label Content="Search _text" Target="{Binding ElementName=Query}"/><TextBox x:Name="Query" AutomationProperties.Name="Search text" Width="300" ToolTip="Literal text, case insensitive"/></StackPanel><Button x:Name="Search" Content="Search" Style="{StaticResource PrimaryAction}" VerticalAlignment="Bottom"/></WrapPanel>
<WrapPanel><TextBlock x:Name="ActiveFilters" MaxWidth="700" TextWrapping="Wrap" Margin="8" VerticalAlignment="Center"/><Button x:Name="ClearFilters" Content="Clear filters"/></WrapPanel>
<Expander x:Name="CorpusFilters" Header="Subject, channel, video and date filters" Margin="4"><StackPanel><WrapPanel><StackPanel><Label Content="Subject" Target="{Binding ElementName=SearchSubject}"/><ComboBox AutomationProperties.Name="Subject" x:Name="SearchSubject" DisplayMemberPath="DisplayName"/></StackPanel><Button x:Name="ClearSearchSubject" Content="All subjects" VerticalAlignment="Bottom"/><StackPanel><Label Content="Channel name or ID" Target="{Binding ElementName=SearchChannel}"/><TextBox AutomationProperties.Name="Channel name or ID" x:Name="SearchChannel" Width="180"/></StackPanel><StackPanel><Label Content="Video title or ID" Target="{Binding ElementName=SearchVideo}"/><TextBox AutomationProperties.Name="Video title or ID" x:Name="SearchVideo" Width="180"/></StackPanel></WrapPanel><WrapPanel><TextBlock Text="Published from" VerticalAlignment="Center" Margin="4"/><DatePicker AutomationProperties.Name="Published from" x:Name="DateFrom" Width="145" Margin="4"/><TextBlock Text="through" VerticalAlignment="Center" Margin="4"/><DatePicker AutomationProperties.Name="Published through" x:Name="DateTo" Width="145" Margin="4"/></WrapPanel></StackPanel></Expander>
<TextBlock x:Name="AppliedSearch" Text="Showing: all saved videos" TextWrapping="Wrap" Margin="8,4" Foreground="#52657A"/>
<WrapPanel><Button x:Name="OpenTranscript" Content="Read transcript"/><Button x:Name="OpenResult" Content="Open on YouTube"/></WrapPanel><TextBlock x:Name="CorpusNotice" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Text="Select a video and press Read transcript, or double-click its row." Margin="8"/>
</StackPanel></ScrollViewer>
<WrapPanel DockPanel.Dock="Bottom"><Button x:Name="Build" Content="Export Excel workbook"/><Button x:Name="OpenWorkbook" Content="Open workbook"/><CheckBox x:Name="AutoExport" Content="Also export Excel after imports" Margin="12" VerticalAlignment="Center"/></WrapPanel>
<Grid><DataGrid AutomationProperties.Name="Saved videos" x:Name="CorpusGrid" Margin="4"/><DataGrid AutomationProperties.Name="Transcript search results" x:Name="SearchGrid" Visibility="Collapsed" Margin="4" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Channel" Binding="{Binding ChannelName}"/><DataGridTextColumn Header="Video" Binding="{Binding VideoTitle}" Width="260"/><DataGridTextColumn Header="Timestamp" Binding="{Binding TimestampDisplay}"/><DataGridTextColumn Header="Transcript" Binding="{Binding TranscriptText}" Width="*"/></DataGrid.Columns></DataGrid></Grid>
</DockPanel></TabItem>
<TabItem Header="Logs / Status"><DockPanel Margin="12"><Button x:Name="OpenLogs" DockPanel.Dock="Top" Content="Open logs folder" HorizontalAlignment="Left"/><TextBox x:Name="LogText" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel></TabItem>
<TabItem x:Name="SettingsTab" Header="Settings">
<TabControl Margin="12">
<TabItem Header="Dependencies"><DockPanel Margin="12">
<StackPanel DockPanel.Dock="Top">
<TextBlock Text="Dependency updates" FontSize="22" Margin="4,0,4,8"/>
<TextBlock Text="Automatic checks run at most once daily. Updates run only when you select them. Check failures appear as Unknown." TextWrapping="Wrap" Margin="4"/>
<WrapPanel>
<TextBlock Text="yt-dlp channel" VerticalAlignment="Center" Margin="4"/>
<ComboBox x:Name="DependencyChannel" SelectedIndex="0" MinWidth="130"><ComboBoxItem Content="stable"/><ComboBoxItem Content="nightly"/></ComboBox>
<Button x:Name="CheckDependencies" Content="Check now"/>
<Button x:Name="UpdateDependencies" Content="Update selected"/>
<Button x:Name="RestartApplication" Content="Restart now" Visibility="Collapsed"/>
<Button x:Name="RecoverDependencies" Content="Recover interrupted update"/>
</WrapPanel>
<TextBlock x:Name="DependencyNotice" Text="Select the checkboxes for updates to install. FFmpeg and ffprobe are updated as one pair." Margin="4,8" TextWrapping="Wrap"/>
</StackPanel>
<TextBlock DockPanel.Dock="Bottom" Text="Tools are installed in your user folder. YT-OSINT restarts automatically after updates." Margin="4,12" TextWrapping="Wrap"/>
<DataGrid x:Name="DependenciesGrid" AutoGenerateColumns="False" IsReadOnly="False" Margin="4" CanUserSortColumns="True">
<DataGrid.Columns>
<DataGridCheckBoxColumn Header="Update" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"><DataGridCheckBoxColumn.ElementStyle><Style TargetType="CheckBox"><Setter Property="IsEnabled" Value="{Binding CanUpdate}"/></Style></DataGridCheckBoxColumn.ElementStyle></DataGridCheckBoxColumn>
<DataGridTextColumn Header="Dependency" Binding="{Binding Name}" IsReadOnly="True"/>
<DataGridTextColumn Header="Installed" Binding="{Binding InstalledVersion}" IsReadOnly="True"/>
<DataGridTextColumn Header="Available" Binding="{Binding AvailableVersion}" IsReadOnly="True"/>
<DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True"/>
<DataGridTextColumn Header="Installed build" Binding="{Binding InstalledChannel}" IsReadOnly="True"/>
<DataGridTextColumn Header="Target provider" Binding="{Binding Provider}" IsReadOnly="True"/>
<DataGridTextColumn Header="Target channel" Binding="{Binding Channel}" IsReadOnly="True"/>
<DataGridTextColumn Header="Path" Binding="{Binding Path}" IsReadOnly="True"/>
<DataGridTextColumn Header="Last check (UTC)" Binding="{Binding LastCheck}" IsReadOnly="True"/>
<DataGridTextColumn Header="Details" Binding="{Binding Detail}" IsReadOnly="True"/>
</DataGrid.Columns></DataGrid>
</DockPanel></TabItem>
<TabItem x:Name="StorageTab" Header="Storage"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
<TextBlock Text="Storage and sync freshness" FontSize="22" Margin="4,0,4,12"/>
<TextBlock x:Name="Paths" TextWrapping="Wrap"/>
<TextBlock Text="Corpus folder" Margin="4,16,4,0"/><DockPanel><Button x:Name="BrowseStorage" Content="Browse…" DockPanel.Dock="Right"/><TextBox x:Name="StorageRoot" ToolTip="Absolute path to the corpus folder"/></DockPanel>
<TextBlock Text="Configuration, data, queue history, exports and logs stay together in this folder." TextWrapping="Wrap" Margin="4"/>
<RadioButton x:Name="StorageSwitch" GroupName="StorageMode" Content="Switch/create corpus — open an existing corpus or create an empty one" IsChecked="True" Margin="4,8"/>
<RadioButton x:Name="StorageMove" GroupName="StorageMode" Content="Move existing corpus — copy and verify current data, then use the new folder" Margin="4,8"/>
<TextBlock Text="Move requires an empty destination and retains the original as a backup. Switch leaves the current corpus untouched. Location changes require a restart; pending work stays paused." TextWrapping="Wrap" Margin="4"/>
<TextBlock x:Name="StoragePreview" TextWrapping="Wrap" Margin="4,8"/>
<WrapPanel><TextBlock Text="Consider channels stale after" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="StaleDays" Width="70"/><TextBlock Text="days (1–3650)" VerticalAlignment="Center"/></WrapPanel>
<WrapPanel><Button x:Name="SaveStorage" Content="Save settings"/><Button x:Name="CancelStorage" Content="Cancel changes"/><Button x:Name="StorageRestart" Content="Restart to apply location" Visibility="Collapsed"/></WrapPanel>
<TextBlock x:Name="StorageNotice" TextWrapping="Wrap" Margin="4"/>
<WrapPanel Margin="0,12"><Button x:Name="OpenData" Content="Open data folder"/><Button x:Name="OpenConfig" Content="Open configuration"/></WrapPanel>
</StackPanel></ScrollViewer></TabItem>
<TabItem x:Name="AboutTab" Header="About"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="800" HorizontalAlignment="Left">
<Border Background="#094184" Padding="16" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Image x:Name="CompanyLogo" Height="180" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Columbia Cloudworks"/>
<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0"><TextBlock Text="YT-OSINT" Foreground="White" FontFamily="Aptos Display, Segoe UI" FontSize="28" FontWeight="Bold" Margin="0,0,0,12"/>
<TextBlock x:Name="AboutVersion" Foreground="White" Margin="0,0,0,12"/>
<TextBlock Text="Published and owned by" Foreground="White"/><TextBlock Text="Columbia Cloudworks LLC" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
</Grid></Border>
<TextBlock Text="A Columbia Cloudworks OSINT product for collecting, organizing and searching a local YouTube corpus." Margin="4,12" TextWrapping="Wrap"/>
<TextBlock Text="Copyright © 2026 Columbia Cloudworks LLC. All rights reserved." Margin="4,12" TextWrapping="Wrap"/>
<TextBlock Text="Columbia Cloudworks branding belongs to Columbia Cloudworks LLC. Third-party tools retain their respective licenses. Captured content remains subject to its owners’ rights. This product is not affiliated with or endorsed by YouTube or Google." Margin="4" TextWrapping="Wrap"/>
<Button x:Name="AboutRepository" Content="Project repository" HorizontalAlignment="Left" Margin="4,16"/>
</StackPanel></ScrollViewer></TabItem>
</TabControl></TabItem>
</TabControl></DockPanel></Window>
